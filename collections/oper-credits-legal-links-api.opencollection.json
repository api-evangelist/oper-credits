{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oper Credits Agent Documents Legal Links API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Legal Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_legal_links_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/legal-links/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "api_legal_links_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/legal-links/:language__definition/",
            "params": [
              {
                "name": "language__definition",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}